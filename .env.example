# Optional PostgreSQL connection string (use Supabase transaction pooler :6543 in production).
# When unset, Établi runs deterministically in local IndexedDB + seeded telemetry mode (hasDatabase() === false).
DATABASE_URL=

# Daily-rotating client fingerprint HMAC salt (raw IPs are never stored)
IP_HASH_SECRET=

# Shared HMAC secret for signed advisor review sign-off webhooks (/api/webhooks/advisor-signoff)
WEBHOOK_SIGNING_SECRET=

# Shared bearer / x-admin-secret token for /api/admin/seed
ADMIN_SECRET=
